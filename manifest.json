{
  "manifest_version": 3,
  "name": "File2MD",
  "version": "1.0.0",
  "description": "File2MD — Convert .txt, .py, .js, .html, .css, .json, .csv files to Markdown instantly. 100% local, nothing uploaded.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "File2MD",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "host_permissions": []
}
